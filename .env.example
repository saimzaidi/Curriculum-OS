APP_ENV=development
APP_SECRET=replace-with-a-32-character-minimum-random-value-before-launch
DATABASE_PATH=data/curriculumos.db
UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_MB=100
MAX_DOCUMENT_PAGES=300
LOG_LEVEL=INFO
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RAG_ANYTHING_ENABLED=false
RAG_ANYTHING_WORKDIR=data/rag-anything
RAG_ANYTHING_API_KEY=
RAG_ANYTHING_BASE_URL=
RAG_ANYTHING_LLM_MODEL=gpt-4o-mini
RAG_ANYTHING_EMBEDDING_MODEL=text-embedding-3-large
